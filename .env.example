# Variáveis do Análise das Redes Sociais.
# Local: copie este arquivo para .env.local (ele não vai para o Git).
# Produção: cadastre cada linha em Vercel > Settings > Environment Variables.
# Nunca coloque valores reais neste arquivo, nem no index.html.

# ── Supabase (projeto do painel) ─────────────────────────────────────────────
# URL e chave anônima são públicas. A chave service_role é SECRETA: só no servidor.
SUPABASE_URL=https://ggphrgfgckpsspbsguhp.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Cofre de tokens da Meta ──────────────────────────────────────────────────
# 32 bytes em base64. Gerar: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Trocar esta chave invalida os tokens guardados (as contas precisam ser reconectadas).
TOKEN_ENCRYPTION_KEY=

# ── Meta for Developers ──────────────────────────────────────────────────────
META_APP_ID=
# Segredo do app: só no servidor. Nunca no navegador.
META_APP_SECRET=
# ID da configuração do Login do Facebook para Empresas (não é segredo). Quando definido, o login usa
# config_id e não envia scope. Criar em: Login do Facebook para Empresas › Configurações.
META_LOGIN_CONFIG_ID=
# Tem que ser exatamente uma das "Valid OAuth Redirect URIs" cadastradas no app da Meta.
META_REDIRECT_URI=https://redes-sociais-gilt-alpha.vercel.app/api/analise?acao=meta-callback
# ── Contas do portfólio (usuário do sistema do Business Manager) ─────────────
# Token gerado para o usuário do sistema, com acesso às contas de Instagram do portfólio.
# Só no servidor (Sensitive). Aparece uma única vez, na hora da geração.
INSTAGRAM_SYSTEM_TOKEN=

# ── Login direto do Instagram (sem Página do Facebook) ───────────────────────
# Estes valores vêm do produto Instagram do app (Configurar login do Instagram empresarial),
# que podem ser diferentes do ID e da chave do app de Facebook.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Tem que ser exatamente uma das "OAuth redirect URIs" do login do Instagram empresarial.
INSTAGRAM_REDIRECT_URI=https://redes-sociais-gilt-alpha.vercel.app/api/analise?acao=ig-callback
# Endereço do painel, para voltar a ele depois do login da Meta.
APP_URL=https://redes-sociais-gilt-alpha.vercel.app
