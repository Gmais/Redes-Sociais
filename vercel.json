{
  "functions": {
    "api/generate-image.js": {
      "maxDuration": 120,
      "includeFiles": "assets/marcas/**"
    },
    "api/gympulse-ranking.js": {
      "maxDuration": 120,
      "includeFiles": "assets/fonts/**"
    },
    "api/auto-content.js": {
      "maxDuration": 120,
      "includeFiles": "CONTEXTO.md"
    }
  },
  "crons": [
    {
      "path": "/api/auto-content",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/gympulse-ranking",
      "schedule": "0 1 * * 2-6"
    },
    {
      "path": "/api/gympulse-ranking?tentativa=2",
      "schedule": "0 2 * * 2-6"
    }
  ]
}
