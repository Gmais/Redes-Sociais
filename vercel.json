{
  "functions": {
    "api/generate-image.js": {
      "maxDuration": 120,
      "includeFiles": "assets/marcas/**"
    },
    "api/gympulse-ranking.js": {
      "maxDuration": 120,
      "includeFiles": "assets/fonts/**"
    },
    "api/auto-content.js": {
      "maxDuration": 120,
      "includeFiles": "{CONTEXTO.md,instagram/*/voice.md}"
    },
    "api/analise.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/api/zernio-health", "destination": "/api/zernio?acao=health" },
    { "source": "/api/zernio-post-status", "destination": "/api/zernio?acao=post-status" },
    { "source": "/api/zernio-retry-post", "destination": "/api/zernio?acao=retry-post" },
    { "source": "/api/zernio-cancel-post", "destination": "/api/zernio?acao=cancel-post" },
    { "source": "/api/zernio-media-upload", "destination": "/api/zernio?acao=media-upload" }
  ],
  "crons": [
    {
      "path": "/api/auto-content",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/gympulse-ranking",
      "schedule": "0 1 * * 2-6"
    },
    {
      "path": "/api/gympulse-ranking?tentativa=2",
      "schedule": "0 2 * * 2-6"
    }
  ]
}
